# Copy this file to `.env` and adjust the values for your machine.
#
#   cp .env.example .env
#   docker compose up -d postgres
#
# `.env` is gitignored. Never commit real credentials.

# --- Spring ---------------------------------------------------------------
# dev (in-memory H2) | postgres (local PostgreSQL) | prod (managed PostgreSQL)
SPRING_PROFILES_ACTIVE=dev
ADMIN_USERNAME=admin
# Required in every profile: the application refuses to start when this is blank.
ADMIN_PASSWORD=change-me
PORT=8080

# --- Development H2 (dev profile only) -------------------------------------
H2_PASSWORD=password

# --- PostgreSQL (postgres and prod profiles) -------------------------------
# DB_PORT is the host port published by docker-compose.yml; keep it in sync
# with DB_URL if you change one.
DB_PORT=5432
DB_NAME=store_tracker
DB_URL=jdbc:postgresql://localhost:5432/store_tracker
DB_USERNAME=tracker
DB_PASSWORD=tracker
